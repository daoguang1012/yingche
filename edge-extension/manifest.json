{
  "manifest_version": 3,
  "name": "映澈 · 网页美颜与换脸",
  "version": "0.4.1",
  "description": "GPUPixel 美颜与 Deep-Live-Cam 换脸，仅处理主动启用的网页视频。",
  "key": "",
  "minimum_chrome_version": "132",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:18766/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "映澈网页增强"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
