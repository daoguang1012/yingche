{
  "manifest_version": 3,
  "name": "映澈 · 网页美颜与换脸",
  "version": "0.6.1",
  "description": "本机 AI 美颜、换脸与 60 FPS 神经网络补帧，支持 RTX VSR 兼容视频输出。",
  "key": "",
  "minimum_chrome_version": "132",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:18766/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "映澈网页增强"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/framegen/rt_v7s.bin",
        "vendor/framegen/rt_v7s.json"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
